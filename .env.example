DATABASE_URL="mysql://azura:azura_pass@localhost:3306/azura"
NEXTAUTH_URL="http://localhost:3000"
# Required: long random string — placeholders are rejected by Docker entrypoint
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@azura.local"
ADMIN_PASSWORD="changeme"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID="G-WE9VQ42BG0"
MYSQL_ROOT_PASSWORD="azura_root"
MYSQL_DATABASE="azura"
MYSQL_USER="azura"
MYSQL_PASSWORD="azura_pass"
# Production / upgrades: leave false. Use true only on a fresh empty database.
RUN_SEED="false"
# When RUN_SEED=true: "safe" (upsert, no wipe) or "fresh" (destructive demo reset).
SEED_MODE="safe"
