{
  "name": "azura-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "db:setup": "prisma migrate deploy && SEED_MODE=fresh RUN_SEED=true node prisma/seed.mjs",
    "db:backfill": "node scripts/backfill-compat.mjs",
    "test": "node --test lib/metrics/__tests__/**/*.test.mjs lib/viz/__tests__/**/*.test.mjs lib/story/__tests__/**/*.test.mjs lib/case-study/__tests__/**/*.test.mjs lib/career/__tests__/**/*.test.mjs lib/homepage/__tests__/**/*.test.mjs lib/motion/__tests__/**/*.test.mjs lib/presentation/__tests__/**/*.test.mjs lib/import/__tests__/**/*.test.mjs lib/export/__tests__/**/*.test.mjs lib/seo/__tests__/**/*.test.mjs lib/migrate/__tests__/**/*.test.mjs lib/__tests__/**/*.test.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "bcryptjs": "^3.0.3",
    "formidable": "^3.5.4",
    "framer-motion": "^12.43.0",
    "isomorphic-dompurify": "^3.19.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-rough-notation": "^1.0.8",
    "react-scroll": "^1.9.3",
    "react-scroll-parallax": "^3.5.0",
    "recharts": "^2.15.0",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.6",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.19"
  }
}
